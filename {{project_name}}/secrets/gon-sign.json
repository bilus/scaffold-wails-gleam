{
    "source": ["./build/bin/{{project_name}}.app"],
    "bundle_id": "{{bundle_id}}",
    "apple_id": {
        "username": "{{author_email}}",
        "password": "@env:AC_PASSWORD",
        "provider": "{{apple_team_id}}"
    },
    "sign": {
        "application_identity": "Developer ID Application: {{author_name}} ({{apple_team_id}})"
    }
}
